{
  "name": "simpleshare",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd client && vite",
    "dev:backend": "cd backend && NODE_ENV=development tsc && cd .. && NODE_ENV=development nodemon dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "cd backend && tsc",
    "build:frontend": "cd client && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "setup": "npx prisma generate && npx prisma migrate dev --name first",
    "update:start": "node set-update-status.js true",
    "update:stop": "node set-update-status.js false"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mariadb": "^3.4.5",
    "multer": "^2.0.2",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.28",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "vite": "^7.3.6"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  }
}
